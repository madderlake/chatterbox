{
  "name": "chatterbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@vitejs/plugin-react-swc": "^3.7.1",
    "autoprefixer": "^10.4.14",
    "bootstrap": "^5.3.1",
    "classnames": "^2.3.1",
    "cors": "^2.8.5",
    "express": "^4.17.2",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.26",
    "postcss-cli": "^10.1.0",
    "postcss-nested": "^6.0.1",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "react-router-dom": "^5.3.0",
    "socket.io": "^4.4.0",
    "socket.io-client": "^4.4.0",
    "tsx": "^4.19.2",
    "uuid": "^8.3.2",
    "vite": "^5.4.10",
    "vite-plugin-svgr": "^4.2.0",
    "vite-tsconfig-paths": "^5.0.1"
  },
  "overrides": {
    "typescript": "^5.1.6"
  },
  "scripts": {
    "build:css": "postcss src/client/styles/main.css -o src/index.css",
    "watch:css": "postcss src/client/styles/main.css -o src/index.css -w",
    "watch-node": "nodemon --watch src/server/listeners.ts server.ts",
    "start": "tsx src/server.ts",
    "dev": "vite --port 3000 && env-cmd -f .env.development  watch:css",
    "build": "tsc && vite build",
    "serve": "vite preview",
    "test": "react-scripts test --env=jsdom",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.3%",
      "not ie 11",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version",
      ">0.3%",
      "not ie 11",
      "not dead",
      "not op_mini all"
    ]
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.3",
    "@types/node": "^20.4.8",
    "@types/react": "^18.2.18",
    "@types/react-dom": "^18.2.7",
    "@types/react-redux": "^7.1.25",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "@types/uuid": "^9.0.2",
    "env-cmd": "^10.1.0",
    "nodemon": "^3.0.1",
    "npm-run-all": "^4.1.5",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  },
  "packageManager": "pnpm@9.12.2+sha512.22721b3a11f81661ae1ec68ce1a7b879425a1ca5b991c975b074ac220b187ce56c708fe5db69f4c962c989452eee76c82877f4ee80f474cebd61ee13461b6228"
}
